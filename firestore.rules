rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Data model (written by the `api` Cloud Function via the Admin SDK,
    // which bypasses these rules — see server/firestore-store.js)
    // ===============================================================
    //
    // users/{uid}                              profile — the ONLY doc clients write
    //                                          (src/firebase-auth.js mirrors it on sign-in;
    //                                          beforeUserCreated also creates it)
    // users/{uid}/settings/products            per-user product/fee overrides
    // users/{uid}/settings/storage             { layout: 2 } once accounts are id-keyed
    // users/{uid}/library/{itemId}             Film Room clips whose account was deleted
    // users/{uid}/accounts/{journalId}         account (journal) + derived balance/equity
    //   trades/{tradeId}                       round-trip trade + nested `meta` (tags, review)
    //   fills/{fillId}                         raw Tradovate fills (source of truth for trades)
    //   payouts/{payoutId} · manualDays/{date} · dayLogs/{date}
    //
    // Legacy (layout 1): accounts/{accountName} — kept untouched as a backup.
    // Retired: users/{uid}/sessions — drained by the server.
    // ===============================================================

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function validOptionalString(data, field, maxSize) {
      return !(field in data) || data[field] == null ||
        (data[field] is string && data[field].size() <= maxSize);
    }

    function validOptionalEmail(data) {
      return !('email' in data) || data.email == null ||
        (data.email is string && data.email.size() <= 320);
    }

    function validUserProfile(userId, data) {
      return data.keys().hasOnly([
          'displayName', 'email', 'photoURL', 'uid', 'userId', 'authUid',
          'createdAt', 'updatedAt', 'source'
        ]) &&
        validOptionalString(data, 'displayName', 120) &&
        validOptionalEmail(data) &&
        validOptionalString(data, 'photoURL', 2048) &&
        (!('uid' in data) || data.uid == userId) &&
        (!('authUid' in data) || data.authUid == userId) &&
        (!('userId' in data) || data.userId == userId);
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId) &&
        validUserProfile(userId, request.resource.data);
      allow delete: if false;

      // Everything under the profile is server-owned: the API keeps a working
      // copy and diffs it against Firestore, so a direct client write would be
      // overwritten (or deleted) on the next save. Owners may read their own data.
      match /{document=**} {
        allow read: if isOwner(userId);
        allow write: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
