{
  "functions": {
    "source": "functions"
  },
  "auth": {
    "providers": {
      "emailPassword": true,
      "googleSignIn": {
        "oAuthBrandDisplayName": "Trade Journal",
        "supportEmail": "yoavgecht@gmail.com",
        "authorizedRedirectUris": [
          "http://localhost",
          "https://trade-journal-d7e7a.web.app",
          "https://trade-journal-d7e7a.firebaseapp.com"
        ]
      }
    }
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api/**",
        "function": "api"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
